# All optional. Without them EvalGate runs in deterministic mock mode.
EVALGATE_MOCK=1
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
EVALGATE_GITLAB_TOKEN=     # project access token (api) — posts MR notes / incident issues
EVALGATE_TARGET_URL=       # deployed service for `python -m evalgate monitor`
GCP_PROJECT_ID=
GCP_REGION=asia-south1
